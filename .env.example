# Copie para .env apenas quando a integração Groq for implementada (TSK-002).
# O código da TSK-001 lê variáveis do ambiente; ele não carrega este arquivo.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHROMA_DIR=.local/chroma
SQLITE_PATH=.local/protocolos.sqlite3
RAG_TOP_K=3
MAX_AGENT_ROUNDS=6
LOG_DIR=artifacts/logs
