# Copie para .env somente no ambiente local. O arquivo .env é ignorado pelo Git.
# Os comandos carregam explicitamente o .env da raiz com prioridade menor que o ambiente.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHROMA_DIR=.local/chroma
SQLITE_PATH=.local/protocolos.sqlite3
RAG_TOP_K=3
MAX_AGENT_ROUNDS=6
LOG_DIR=artifacts/logs
